{
  "id": "dual-memory",
  "kind": "memory",
  "uiHints": {
    "neo4j.uri": {
      "label": "Neo4j URI",
      "placeholder": "bolt://localhost:7687",
      "help": "Bolt protocol URI for Neo4j instance"
    },
    "neo4j.password": {
      "label": "Neo4j Password",
      "sensitive": true,
      "placeholder": "dualmemory2026",
      "help": "Password for Neo4j (or use ${NEO4J_PASSWORD})"
    },
    "embedding.provider": {
      "label": "Embedding Provider",
      "placeholder": "voyage",
      "help": "Embedding provider: voyage (default, Anthropic recommended) or openai"
    },
    "embedding.apiKey": {
      "label": "Embedding API Key",
      "sensitive": true,
      "placeholder": "pa-...",
      "help": "API key for embeddings (or use ${VOYAGE_API_KEY} / ${OPENAI_API_KEY})"
    },
    "embedding.model": {
      "label": "Embedding Model",
      "placeholder": "voyage-4-lite",
      "help": "Embedding model: voyage-4-lite (default), voyage-4, text-embedding-3-small, etc."
    },
    "extraction.provider": {
      "label": "Extraction LLM Provider",
      "placeholder": "anthropic",
      "help": "LLM provider for fact extraction: anthropic (default) or openai"
    },
    "extraction.apiKey": {
      "label": "Extraction API Key",
      "sensitive": true,
      "help": "API key for extraction LLM. Falls back to ANTHROPIC_API_KEY env var."
    },
    "extraction.model": {
      "label": "Extraction Model",
      "placeholder": "claude-sonnet-4-20250514",
      "help": "Model for fact extraction (default: claude-sonnet-4-20250514 for anthropic, gpt-4o-mini for openai)"
    },
    "autoCapture": {
      "label": "Auto-Capture",
      "help": "Automatically extract facts from conversations"
    },
    "autoRecall": {
      "label": "Auto-Recall",
      "help": "Automatically inject relevant memories into context"
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "neo4j": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "uri": { "type": "string" },
          "user": { "type": "string" },
          "password": { "type": "string" }
        },
        "required": ["password"]
      },
      "embedding": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string",
            "enum": ["voyage", "openai"]
          },
          "apiKey": { "type": "string" },
          "model": {
            "type": "string",
            "enum": [
              "voyage-4-lite", "voyage-4", "voyage-4-large",
              "voyage-code-3", "voyage-3-lite", "voyage-3",
              "text-embedding-3-small", "text-embedding-3-large"
            ]
          }
        },
        "required": ["apiKey"]
      },
      "extraction": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string",
            "enum": ["anthropic", "openai"]
          },
          "apiKey": { "type": "string" },
          "model": { "type": "string" }
        }
      },
      "autoCapture": { "type": "boolean" },
      "autoRecall": { "type": "boolean" }
    },
    "required": ["neo4j", "embedding"]
  }
}
